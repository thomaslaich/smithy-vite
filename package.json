{
  "name": "smithy-vite",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/codegen",
    "packages/plugin",
    "examples/*"
  ],
  "scripts": {
    "build:integration": "gradle -p codegen publish",
    "prepare:cli": "node scripts/prepare-smithy-cli-packages.mjs",
    "generate": "npm run generate:react && npm run generate:preact && npm run generate:solid && npm run generate:vue && npm run generate:angular",
    "generate:react": "npm run generate --workspace @smithy-vite/example-vite",
    "generate:preact": "npm run generate --workspace @smithy-vite/example-vite-preact",
    "generate:solid": "npm run generate --workspace @smithy-vite/example-vite-solid",
    "generate:vue": "npm run generate --workspace @smithy-vite/example-vite-vue",
    "generate:angular": "npm run generate --workspace @smithy-vite/example-vite-angular",
    "dev": "npm run dev --workspace @smithy-vite/example-vite",
    "dev:preact": "npm run dev --workspace @smithy-vite/example-vite-preact",
    "dev:solid": "npm run dev --workspace @smithy-vite/example-vite-solid",
    "dev:vue": "npm run dev --workspace @smithy-vite/example-vite-vue",
    "dev:angular": "npm run dev --workspace @smithy-vite/example-vite-angular",
    "build": "npm run build:react && npm run build:preact && npm run build:solid && npm run build:vue && npm run build:angular",
    "build:react": "npm run build --workspace @smithy-vite/example-vite",
    "build:preact": "npm run build --workspace @smithy-vite/example-vite-preact",
    "build:solid": "npm run build --workspace @smithy-vite/example-vite-solid",
    "build:vue": "npm run build --workspace @smithy-vite/example-vite-vue",
    "build:angular": "npm run build --workspace @smithy-vite/example-vite-angular",
    "typecheck": "npm run typecheck:react && npm run typecheck:preact && npm run typecheck:solid && npm run typecheck:vue && npm run typecheck:angular",
    "typecheck:react": "npm run typecheck --workspace @smithy-vite/example-vite",
    "typecheck:preact": "npm run typecheck --workspace @smithy-vite/example-vite-preact",
    "typecheck:solid": "npm run typecheck --workspace @smithy-vite/example-vite-solid",
    "typecheck:vue": "npm run typecheck --workspace @smithy-vite/example-vite-vue",
    "typecheck:angular": "npm run typecheck --workspace @smithy-vite/example-vite-angular",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "fflate": "^0.8.2"
  }
}
