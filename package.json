{
  "name": "smithy-vite-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/codegen",
    "packages/plugin",
    "examples/*"
  ],
  "scripts": {
    "build:integration": "gradle -p codegen publish",
    "prepare:cli": "node scripts/prepare-smithy-cli-packages.mjs",
    "generate": "npm run generate --workspace @smithy-vite/example-vite",
    "dev": "npm run dev --workspace @smithy-vite/example-vite",
    "build": "npm run build --workspace @smithy-vite/example-vite",
    "typecheck": "npm run typecheck --workspace @smithy-vite/example-vite",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "fflate": "^0.8.2"
  }
}
