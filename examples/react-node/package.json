{
  "name": "@smithy-vite/example-react-node",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate": "npm run generate:client && npm run generate:server",
    "generate:client": "smithy-vite --config smithy-client.json",
    "generate:server": "smithy-vite --config smithy-server.json",
    "dev": "concurrently --kill-others \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/start-server.cts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.cts"
  },
  "dependencies": {
    "@aws-sdk/core": "^3.977.6",
    "@smithy/core": "^3.31.1",
    "@smithy/fetch-http-handler": "^5.6.13",
    "@smithy/node-http-handler": "^4.9.13",
    "@smithy/server-common": "0.2.0",
    "@smithy/server-node": "0.2.0",
    "@smithy/types": "^4.16.1",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@smithy-vite/codegen": "0.0.1-spike",
    "@smithy-vite/plugin": "0.0.1-spike",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
