{
  "name": "@smithy-vite/codegen",
  "version": "0.0.1-spike",
  "description": "Hermetic npm-native Smithy TypeScript code generation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "smithy-vite": "./src/cli.js"
  },
  "scripts": {
    "prepack": "node scripts/validate-vendor.mjs"
  },
  "files": [
    "scripts",
    "src",
    "vendor"
  ],
  "optionalDependencies": {
    "@smithy-vite/smithy-cli-darwin-arm64": "0.0.1-spike",
    "@smithy-vite/smithy-cli-darwin-x64": "0.0.1-spike",
    "@smithy-vite/smithy-cli-linux-arm64": "0.0.1-spike",
    "@smithy-vite/smithy-cli-linux-x64": "0.0.1-spike",
    "@smithy-vite/smithy-cli-win32-x64": "0.0.1-spike"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomaslaich/smithy-vite.git",
    "directory": "packages/codegen"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
