{
  // Type-checks the JavaScript sources of the published packages against
  // their hand-written declarations, so the two cannot drift apart.
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    // Not strict: the goal is that the code agrees with its declarations, not
    // full annotation of every local.
    "strict": false,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": [
    "codegen/src/**/*.js",
    "plugin/src/**/*.js",
    "plugin/test/**/*.js"
  ]
}
