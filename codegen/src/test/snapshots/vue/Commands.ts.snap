export const useRunCommandMutation = <TOnMutateResult = unknown>(
  options?: RunCommandMutationOptions<TOnMutateResult>,
): UseMutationReturnType<
  RunCommandCommandOutput,
  Error,
  RunCommandCommandInput,
  TOnMutateResult
