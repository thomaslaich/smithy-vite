import { type MutationOptions, type UseMutationReturnType, mutationOptions, useMutation } from "@tanstack/vue-query";
import { type App, type InjectionKey, type MaybeRefOrGetter, type Plugin, inject, toValue } from "vue";

import {
  type RunCommandCommandInput,
  type RunCommandCommandOutput,
  RunCommandCommand,
} from "./commands/RunCommandCommand";
import type { CommandsClient } from "./CommandsClient";


export const runCommandMutationKey = () =>
  ["example.fixtures#Commands", "example.fixtures#RunCommand"] as const;

export const runCommandMutationOptions = (
  client: CommandsClient,
) =>
  mutationOptions({
    mutationKey: runCommandMutationKey(),
    mutationFn: (input: RunCommandCommandInput) =>
      client.send(new RunCommandCommand(input)),
  });

const CommandsClientKey: InjectionKey<CommandsClient> = Symbol("CommandsClient");

export const provideCommandsClient = (client: CommandsClient): Plugin => ({
  install(app: App) {
    app.provide(CommandsClientKey, client);
  },
});

export const useCommandsClient = () => {
  const client = inject(CommandsClientKey);
  if (!client) {
    throw new Error("useCommandsClient requires app.use(provideCommandsClient(client))");
  }
  return client;
};

export const createCommandsApi = (client: CommandsClient) => ({
  runCommand: {
    mutationKey: runCommandMutationKey,
    mutationOptions: () => runCommandMutationOptions(client),
  },
});

export type CommandsApi = ReturnType<typeof createCommandsApi>;

export const useCommandsApi = () => {
  const client = useCommandsClient();
  return createCommandsApi(client);
};

export type RunCommandMutationOptions<TOnMutateResult = unknown> = Omit<
  MutationOptions<
    RunCommandCommandOutput,
    Error,
    RunCommandCommandInput,
    TOnMutateResult
  >,
  "mutationKey" | "mutationFn"
