import { type QueryOptions, type UseQueryResult, queryOptions, useQuery } from "@tanstack/solid-query";
import { type Accessor, type JSX, createComponent, createContext, useContext } from "solid-js";

import { type GetReportCommandInput, type GetReportCommandOutput, GetReportCommand } from "./commands/GetReportCommand";
import type { ReportsClient } from "./ReportsClient";


type MaybeAccessor<T> = T | Accessor<T>;

const resolveMaybeAccessor = <T>(value: MaybeAccessor<T>): T =>
  typeof value === "function" ? (value as Accessor<T>)() : value;

export const getReportQueryKey = (input: GetReportCommandInput) =>
  ["example.fixtures#Reports", "example.fixtures#GetReport", input] as const;

export const getReportQueryOptions = (
  client: ReportsClient,
  input: GetReportCommandInput,
) =>
  queryOptions({
    queryKey: getReportQueryKey(input),
    queryFn: ({ signal }) => client.send(new GetReportCommand(input), { abortSignal: signal }),
  });

const ReportsClientContext = createContext<ReportsClient | undefined>(undefined);

export interface ReportsClientProviderProps {
  client: ReportsClient;
  children?: JSX.Element;
}

export const ReportsClientProvider = (
  props: ReportsClientProviderProps,
) =>
  createComponent(ReportsClientContext.Provider, {
    get value() { return props.client; },
    get children() { return props.children; },
  });

export const useReportsClient = () => {
  const client = useContext(ReportsClientContext);
  if (!client) {
    throw new Error("useReportsClient must be used within a ReportsClientProvider");
  }
  return client;
};

export const createReportsApi = (client: ReportsClient) => ({
  getReport: {
    queryKey: getReportQueryKey,
    queryOptions: (input: GetReportCommandInput) =>
      getReportQueryOptions(client, input),
  },
});

export type ReportsApi = ReturnType<typeof createReportsApi>;

export const useReportsApi = () => {
  const client = useReportsClient();
  return createReportsApi(client);
};

export type GetReportQueryOptions<TData = GetReportCommandOutput> = Omit<
  QueryOptions<
    GetReportCommandOutput,
    Error,
    TData,
    ReturnType<typeof getReportQueryKey>
  >,
  "queryKey" | "queryFn" | "initialData"
> & { initialData?: undefined };

export const useGetReportQuery = <TData = GetReportCommandOutput>(
  input: MaybeAccessor<GetReportCommandInput>,
  options?: GetReportQueryOptions<TData>,
): UseQueryResult<TData, Error> => {
  const client = useReportsClient();
  return useQuery<
    GetReportCommandOutput,
    Error,
    TData,
    ReturnType<typeof getReportQueryKey>
  >(() => {
    const resolvedInput = resolveMaybeAccessor(input);
    const { queryKey, queryFn } = getReportQueryOptions(client, resolvedInput);
    return { ...options, queryKey, queryFn };
  });
};
